{
  "manifest_version": 3,
  "name": "ChatGPT 引用回跳",
  "version": "0.1.0",
  "description": "引用提问后，一键回到原文，再返回回答。",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "css": ["style.css"],
    "run_at": "document_idle"
  }]
}
